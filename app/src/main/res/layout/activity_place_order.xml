<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#120B08"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="30dp"
        android:layout_marginBottom="20dp"
        android:text="Checkout"
        android:textColor="#FFFFFF"
        android:textSize="24sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Delivery Address"
        android:textColor="#CFCFCF"
        android:textSize="14sp" />

    <EditText
        android:id="@+id/edtAddress"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:background="@drawable/edittext_bg"
        android:hint="Enter your delivery address"
        android:minLines="2"
        android:padding="12dp"
        android:textColor="#FFFFFF"
        android:textColorHint="#BBBBBB" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Payment Method"
        android:textColor="#CFCFCF"
        android:textSize="14sp" />

    <Spinner
        android:id="@+id/spinnerPayment"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:background="@drawable/edittext_bg"
        android:padding="10dp" />

    <LinearLayout
        android:id="@+id/cardFieldsLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Name on Card"
            android:textColor="#CFCFCF"
            android:textSize="13sp" />

        <EditText
            android:id="@+id/edtCardName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="10dp"
            android:background="@drawable/edittext_bg"
            android:hint="e.g. R.D.Dilhara"
            android:inputType="textPersonName"
            android:padding="12dp"
            android:textColor="#FFFFFF"
            android:textColorHint="#BBBBBB" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Card Number"
            android:textColor="#CFCFCF"
            android:textSize="13sp" />

        <EditText
            android:id="@+id/edtCardNumber"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="10dp"
            android:background="@drawable/edittext_bg"
            android:hint="1234 5678 9012 3456"
            android:inputType="number"
            android:maxLength="19"
            android:padding="12dp"
            android:textColor="#FFFFFF"
            android:textColorHint="#BBBBBB" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Expiry (MM/YY)"
                    android:textColor="#CFCFCF"
                    android:textSize="13sp" />

                <EditText
                    android:id="@+id/edtCardExpiry"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/edittext_bg"
                    android:hint="MM/YY"
                    android:inputType="number"
                    android:maxLength="5"
                    android:padding="12dp"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#BBBBBB" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="CVV"
                    android:textColor="#CFCFCF"
                    android:textSize="13sp" />

                <EditText
                    android:id="@+id/edtCardCvv"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/edittext_bg"
                    android:hint="123"
                    android:inputType="numberPassword"
                    android:maxLength="3"
                    android:padding="12dp"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#BBBBBB" />

            </LinearLayout>

        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="🔒 This is a demo payment form for the assessment - no real transaction is made."
            android:textColor="#888888"
            android:textSize="11sp" />

    </LinearLayout>

    <TextView
        android:id="@+id/txtOrderTotal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="Total: Rs. 0.00"
        android:textColor="#D89A5C"
        android:textSize="20sp"
        android:textStyle="bold" />

    <Button
        android:id="@+id/btnPlaceOrder"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginTop="20dp"
        android:text="Place Order"
        android:textAllCaps="false"
        android:textColor="#FFFFFF"
        android:backgroundTint="#D89A5C" />

</LinearLayout>
