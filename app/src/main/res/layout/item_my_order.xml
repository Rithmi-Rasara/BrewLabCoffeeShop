<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    app:cardBackgroundColor="#2A1B16"
    app:cardCornerRadius="16dp"
    app:cardElevation="6dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <TextView
            android:id="@+id/txtOrderItems"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Cappuccino x2, Latte x1"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/txtOrderDate"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="01 Jan 2026, 10:00 AM"
                android:textColor="#BBBBBB"
                android:textSize="13sp" />

            <!-- NEW: elapsed time since order placed -->
            <TextView
                android:id="@+id/txtOrderElapsed"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="5 mins ago"
                android:textColor="#D89A5C"
                android:textSize="13sp"
                android:textStyle="italic" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/txtOrderTotal"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Rs. 1750.00"
                android:textColor="#FFB74D"
                android:textSize="16sp"
                android:textStyle="bold" />

            <!-- NEW: colour-coded status badge (background set in code) -->
            <TextView
                android:id="@+id/txtOrderStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_status_pending"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:text="Pending"
                android:textColor="#FFFFFF"
                android:textSize="13sp" />

        </LinearLayout>

        <!-- NEW: only shown when status == "On the way" -->
        <Button
            android:id="@+id/btnTrackMap"
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:layout_marginTop="10dp"
            android:text="Track on Map"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:backgroundTint="#3B82F6"
            android:visibility="gone" />

        <Button
            android:id="@+id/btnReorder"
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:layout_marginTop="8dp"
            android:text="Reorder"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:backgroundTint="#D89A5C" />

    </LinearLayout>

</androidx.cardview.widget.CardView>
