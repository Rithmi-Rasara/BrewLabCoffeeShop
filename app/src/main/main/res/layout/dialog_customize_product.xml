<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#2A1D16">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:id="@+id/txtCustomizeTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:text="Customize Cappuccino"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Size"
            android:textColor="#D89A5C"
            android:textStyle="bold" />

        <RadioGroup
            android:id="@+id/radioGroupSize"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="14dp"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/radioSmall"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:buttonTint="#D89A5C"
                android:text="Small (-Rs.50)"
                android:textColor="#FFFFFF" />

            <RadioButton
                android:id="@+id/radioMedium"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:buttonTint="#D89A5C"
                android:checked="true"
                android:text="Medium"
                android:textColor="#FFFFFF" />

            <RadioButton
                android:id="@+id/radioLarge"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:buttonTint="#D89A5C"
                android:text="Large (+Rs.100)"
                android:textColor="#FFFFFF" />

        </RadioGroup>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Sugar Level"
            android:textColor="#D89A5C"
            android:textStyle="bold" />

        <RadioGroup
            android:id="@+id/radioGroupSugar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="14dp"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/radioNoSugar"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:buttonTint="#D89A5C"
                android:text="No Sugar"
                android:textColor="#FFFFFF" />

            <RadioButton
                android:id="@+id/radioLessSugar"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:buttonTint="#D89A5C"
                android:text="Less"
                android:textColor="#FFFFFF" />

            <RadioButton
                android:id="@+id/radioNormalSugar"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:buttonTint="#D89A5C"
                android:checked="true"
                android:text="Normal"
                android:textColor="#FFFFFF" />

            <RadioButton
                android:id="@+id/radioExtraSugar"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:buttonTint="#D89A5C"
                android:text="Extra"
                android:textColor="#FFFFFF" />

        </RadioGroup>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Add-ons"
            android:textColor="#D89A5C"
            android:textStyle="bold" />

        <CheckBox
            android:id="@+id/checkExtraShot"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:buttonTint="#D89A5C"
            android:text="Extra Espresso Shot (+Rs.100)"
            android:textColor="#FFFFFF" />

        <CheckBox
            android:id="@+id/checkWhippedCream"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:buttonTint="#D89A5C"
            android:text="Whipped Cream (+Rs.80)"
            android:textColor="#FFFFFF" />

        <CheckBox
            android:id="@+id/checkCinnamon"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:buttonTint="#D89A5C"
            android:text="Cinnamon Powder (+Rs.30)"
            android:textColor="#FFFFFF" />

        <TextView
            android:id="@+id/txtCustomizeTotal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:text="Item Total: Rs. 850.00"
            android:textColor="#FFB74D"
            android:textSize="16sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnCustomizeCancel"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:backgroundTint="#3B2A23"
                android:text="Cancel"
                android:textAllCaps="false"
                android:textColor="#FFFFFF" />

            <Button
                android:id="@+id/btnCustomizeAdd"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_weight="1"
                android:backgroundTint="#D89A5C"
                android:text="Add to Cart"
                android:textAllCaps="false"
                android:textColor="#FFFFFF" />

        </LinearLayout>

    </LinearLayout>

</ScrollView>
