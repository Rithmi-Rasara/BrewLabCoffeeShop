<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    app:cardBackgroundColor="#2A1B16"
    app:cardCornerRadius="14dp"
    app:cardElevation="4dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="12dp">

        <CheckBox
            android:id="@+id/checkLineItem"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:buttonTint="#D89A5C" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/txtLineName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Cappuccino x2"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtLineCustomization"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Medium | Normal Sugar"
                android:textColor="#BBBBBB"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/txtLineBrewTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="⏱ Brew time: ~4 mins"
                android:textColor="#D89A5C"
                android:textSize="12sp" />

        </LinearLayout>

        <TextView
            android:id="@+id/txtLinePrice"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Rs. 1700.00"
            android:textColor="#FFB74D"
            android:textSize="14sp"
            android:textStyle="bold" />

    </LinearLayout>

</androidx.cardview.widget.CardView>
